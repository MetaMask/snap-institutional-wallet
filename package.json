{
  "name": "@metamask/snap-institutional-wallet",
  "version": "2.1.0",
  "description": "Institutional accounts in MetaMask",
  "keywords": [
    "metamask",
    "snap",
    "keyring",
    "account"
  ],
  "homepage": "https://github.com/MetaMask/snap-institutional-wallet#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/snap-institutional-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/snap-institutional-wallet.git"
  },
  "license": "(MIT-0 OR Apache-2.0)",
  "author": "",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "allow-scripts": "node ./scripts/allow-scripts.js",
    "build": "yarn workspaces foreach --all --exclude . --parallel --verbose --topological run build",
    "build:dapp": "yarn workspace @metamask/snap-institutional-wallet-site build",
    "build:snap": "yarn workspace @metamask/snap-institutional-wallet-snap build",
    "lint": "yarn workspaces foreach --all --exclude . --parallel --verbose run lint",
    "lint:deps": "yarn workspaces foreach --all --exclude . --parallel --verbose run depcheck",
    "lint:eslint": "yarn workspaces foreach --all --exclude . --parallel --verbose run lint:eslint",
    "lint:fix": "yarn workspaces foreach --all --exclude . --parallel --verbose run lint:fix",
    "lint:misc": "yarn workspaces foreach --all --exclude . --parallel --verbose run lint:misc",
    "lint:types": "yarn workspaces foreach --all --exclude . --parallel --verbose run lint:types",
    "start": "yarn workspaces foreach --all --exclude . --parallel --verbose --interlaced run start",
    "test": "yarn workspaces foreach --all --exclude . --parallel --verbose run test"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^2.0.0",
    "@metamask/eslint-config": "^12.2.0",
    "@metamask/eslint-config-jest": "^12.1.0",
    "@metamask/eslint-config-nodejs": "^12.1.0",
    "@metamask/eslint-config-typescript": "^12.1.0",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "^5.55.0",
    "depcheck": "^1.4.6",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^8.7.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-jsdoc": "^40.0.3",
    "eslint-plugin-n": "^16.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^2.8.4",
    "typescript": "^4.9.5"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^20 || >=22"
  },
  "resolutions": {
    "@graphql-tools/utils@^8.8.0": "^12.0.1",
    "decode-uri-component@^0.2.0": "^0.5.1",
    "hash-base/readable-stream": "^3.6.2",
    "immutable@~3.7.6": "^3.8.4",
    "lodash@~4.17.0": "^4.18.1",
    "path-to-regexp@0.1.12": "~0.1.13",
    "serialize-javascript@^5.0.1": "^7.0.3",
    "serialize-javascript@^6.0.1": "^7.0.3",
    "sharp@^0.32.6": "^0.35.5",
    "tar@^6.1.11": "^7.5.21",
    "tar@^6.1.2": "^7.5.21",
    "tmp@^0.0.33": "^0.2.6",
    "webpack-dev-middleware@^5.3.4": "^7.4.6"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail#2.1.1": false
    }
  }
}
